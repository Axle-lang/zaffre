// controls — the card of things you press, type in and slide.

use zaffre::{
    Model, Notifier, Column, Row, Panel, Label, Button, Switch, Checkbox, Radio, Slider, TextField,
    Tooltip, DialogProps,
    Widget, FlexProps, PanelProps, ButtonProps, SliderProps, FieldProps,
    TextRole, ButtonKind, ControlSize, Tone, Elevation, IconKind, Length, Align,
};

/** Ask whether to delete the profile; the answer shows up as a toast. */
fn askDelete(notes : Shared<Notifier>) : void {
    let question = DialogProps {
        title: "Delete the profile?",
        message: "Its preferences and history are removed for good. This cannot be undone.",
        confirm: "Delete",
        danger: true,
    };
    notes.ask(
        question,
        () => notes.toast("Profile deleted", Tone::Danger),
        () => notes.toast("Nothing was deleted", Tone::Neutral)
    );
}

/** One button of `kind` saying `label`, doing nothing. */
fn plain(label : string, kind : ButtonKind) : Button {
    return new Button(ButtonProps { label: label, kind: kind });
}

/** The row of button kinds, from the loudest to the quietest. */
fn kindsRow(notes : Shared<Notifier>) : Row {
    let save = new Button(
        ButtonProps {
            label: "Save changes",
            kind: ButtonKind::Primary,
            icon: IconKind::Check,
        },
        () => notes.toast("Preferences saved", Tone::Ok)
    );
    let kids : dyn Widget[] = [
        new Tooltip("Store the preferences", save),
        plain("Secondary", ButtonKind::Secondary),
        plain("Tertiary", ButtonKind::Tertiary),
        plain("Outline", ButtonKind::Outline),
    ];
    return new Row(FlexProps { gap: 10.0 }, kids);
}

/** A second row: the solid kinds, and the quiet ones. */
fn moreKindsRow(notes : Shared<Notifier>) : Row {
    let delete = new Button(
        ButtonProps {
            label: "Delete",
            kind: ButtonKind::Danger,
        },
        () => askDelete(notes)
    );
    let kids : dyn Widget[] = [
        delete,
        plain("Success", ButtonKind::Success),
        plain("Important", ButtonKind::Important),
        plain("Ghost", ButtonKind::Ghost),
        plain("Learn more", ButtonKind::Link),
    ];
    return new Row(FlexProps { gap: 10.0 }, kids);
}

/** A third row: a button that is busy, and one that is switched off. */
fn statesRow() : Row {
    let busy = new Button(
        ButtonProps {
            label: "Uploading",
            loading: true,
        }
    );
    let off = new Button(
        ButtonProps {
            label: "Disabled",
            disabled: true,
        }
    );
    let kids : dyn Widget[] = [busy, off];
    return new Row(FlexProps { gap: 10.0 }, kids);
}

/** The same button at its five sizes. */
fn sizesRow() : Row {
    let kids : dyn Widget[] = [
        sized("XS", ControlSize::Xs),
        sized("SM", ControlSize::Sm),
        sized("MD", ControlSize::Md),
        sized("LG", ControlSize::Lg),
        sized("XL", ControlSize::Xl),
    ];
    return new Row(FlexProps { gap: 10.0, align: Align::Center }, kids);
}

/** A secondary button at `size`. */
fn sized(label : string, size : ControlSize) : Button {
    return new Button(
        ButtonProps {
            label: label,
            kind: ButtonKind::Secondary,
            size: size,
        }
    );
}

/** The two text fields: one searching, one holding a name. */
fn fields(search : Shared<Model<string>>, name : Shared<Model<string>>) : Column {
    let searching = new TextField(
        FieldProps {
            placeholder: "Search anything…",
            icon: IconKind::Search,
            width: Length::Fill,
        },
        search
    );
    let naming = new TextField(FieldProps { width: Length::Fill }, name);
    let kids : dyn Widget[] = [searching, naming];
    return new Column(FlexProps { gap: 14.0 }, kids);
}

/** The switch, the checkbox and the radios. */
fn choices(
    notifications : Shared<Model<bool>>,
    newsletter : Shared<Model<bool>>,
    plan : Shared<Model<i32>>
) : Column {
    let toggles : dyn Widget[] = [
        new Switch("Notifications", notifications),
        new Checkbox("Subscribe to the newsletter", newsletter),
    ];
    let plans : dyn Widget[] = [
        new Radio("Free", plan, 0),
        new Radio("Pro", plan, 1),
        new Radio("Team", plan, 2),
    ];
    let kids : dyn Widget[] = [
        new Column(FlexProps { gap: 10.0 }, toggles),
        new Column(FlexProps { gap: 10.0 }, plans),
    ];
    return new Column(FlexProps { gap: 14.0 }, kids);
}

/** The two sliders. */
fn sliders(volume : Shared<Model<f64>>, brightness : Shared<Model<f64>>) : Column {
    let loudness = new Slider(
        SliderProps {
            label: "Volume",
            width: Length::Fill,
        },
        volume
    );
    let light = new Slider(
        SliderProps {
            label: "Brightness",
            min: 0.0,
            max: 100.0,
            step: 5.0,
            decimals: 0,
            width: Length::Fill,
        },
        brightness
    );
    let kids : dyn Widget[] = [loudness, light];
    return new Column(FlexProps { gap: 14.0 }, kids);
}

/** The whole card. */
pub fn controlsCard(
    notes : Shared<Notifier>,
    search : Shared<Model<string>>,
    name : Shared<Model<string>>,
    notifications : Shared<Model<bool>>,
    newsletter : Shared<Model<bool>>,
    plan : Shared<Model<i32>>,
    volume : Shared<Model<f64>>,
    brightness : Shared<Model<f64>>
) : Panel {
    let kids : dyn Widget[] = [
        new Label("Controls", TextRole::H3),
        kindsRow(notes),
        moreKindsRow(notes),
        statesRow(),
        sizesRow(),
        fields(search, name),
        choices(notifications, newsletter, plan),
        sliders(volume, brightness),
    ];
    return new Panel(
        PanelProps {
            elevation: Elevation::Raised,
            grow: 1.3,
        },
        new Column(FlexProps { gap: 18.0 }, kids)
    );
}
