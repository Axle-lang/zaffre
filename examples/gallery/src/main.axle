// gallery — every component, on one page.
//
// The program a first-time reader runs to see the library. It is also the test of the whole stack:
// `--snap` draws one frame to `gallery.bmp` with no window, which is what the README's picture is
// and what a regression check compares.
//
// The page is four cards, one module each (`controls`, `status`, `navigation`, `feedback`), and a
// header. A card is a function that takes the `Model`s it shows and answers a `Panel`; this file
// only creates the models and lays the cards out.

use zaffre::{
    View, Theme, Fonts, App, AppDesc, Model, Notifier, Notifications,
    Column, Row, Widget, FlexProps, Insets, Align,
};
use header::titleBar;
use controls::controlsCard;
use status::statusCard;
use navigation::navigationCard;
use feedback::feedbackCard;
use std::sys::process::{argc, argAt};
use std::lang::IndexOutOfBoundsException;

/** The size of the window, and of the snapshot. */
const WIDTH : i32 = 1040;

/** The height of the window, and of the snapshot. */
const HEIGHT : i32 = 1500;

/** The gap between cards, and the margin around the page. */
const GAP : f64 = 22.0;

/** The whole page, as the view a window or a snapshot shows. */
fn build() : View {
    let fonts : Shared<Fonts> = new shared Fonts();
    // The monospace face is optional and read from a file; without it `Mono` text uses the sans.
    fonts.withMono("assets/fonts/JetBrainsMono-Regular.ttf", "assets/fonts/JetBrainsMono-Bold.ttf");

    // The values the page shows: held here by the program, read and written by the widgets.
    let dark = new shared Model<bool>(true);
    let notes = new shared Notifier();
    let notifications = new shared Model<bool>(true);
    let newsletter = new shared Model<bool>(false);
    let plan = new shared Model<i32>(1);
    let volume = new shared Model<f64>(0.62);
    let brightness = new shared Model<f64>(40.0);
    let name = new shared Model<string>("Ada Lovelace");
    let search = new shared Model<string>("");
    let progress = new shared Model<f64>(0.68);
    let tab = new shared Model<i32>(0);
    let layout = new shared Model<i32>(1);
    let size = new shared Model<i32>(-1);

    // A container takes its children as a `dyn Widget[]`, which the compiler only builds through a
    // `let` with the type written — so each group of children is named.
    let upper : dyn Widget[] = [
        controlsCard(notes, search, name, notifications, newsletter, plan, volume, brightness),
        statusCard(progress),
    ];
    let lower : dyn Widget[] = [
        navigationCard(tab, layout, size),
        feedbackCard(),
    ];
    let rows : dyn Widget[] = [
        titleBar(dark),
        new Row(FlexProps { gap: GAP, align: Align::Start }, upper),
        new Row(FlexProps { gap: GAP, align: Align::Start }, lower),
    ];
    let page = new Column(
        FlexProps {
            gap: GAP,
            padding: Insets::all(28.0),
        },
        rows
    );

    return new View(Theme::dark(), fonts, dark, new Notifications(notes, page));
}

fn main() : i32 {
    let view = build();

    if (wantsSnap()) {
        if (App::snapshot(view, WIDTH, HEIGHT, "gallery.bmp")) {
            println("wrote gallery.bmp");
            return 0;
        }
        println("could not write gallery.bmp");
        return 1;
    }
    let desc = AppDesc {
        title: "zaffre — gallery",
        width: WIDTH,
        height: HEIGHT,
    };
    return App::run(desc, view);
}

/** Whether `--snap` was given: draw one frame to a file and leave. */
fn wantsSnap() : bool {
    let mut i : i32 = 1;
    while (i < argc()) {
        try {
            if (argAt(i) == "--snap") {
                return true;
            }
        } catch e : IndexOutOfBoundsException {
            return false;
        }
        i = i + 1;
    }
    return false;
}
