// status — badges, a progress bar, a spinner and some running text.

use zaffre::{
    Model, Column, Row, Panel, Label, Badge, BadgeProps, ProgressBar, Spinner, Divider,
    Widget, FlexProps, PanelProps, LabelProps,
    TextRole, ControlSize, Tone, BadgeLook, BadgeSize, Elevation, Align,
};

/** One badge in `look`. */
fn badge(text : string, tone : Tone, look : BadgeLook) : Badge {
    return new Badge(
        BadgeProps {
            text: text,
            tone: tone,
            look: look,
        }
    );
}

/** A row of badges, drawn as washes. */
fn subtleRow() : Row {
    let kids : dyn Widget[] = [
        badge("Online", Tone::Ok, BadgeLook::Subtle),
        badge("3 warnings", Tone::Warn, BadgeLook::Subtle),
        badge("Beta", Tone::Accent, BadgeLook::Subtle),
        badge("Offline", Tone::Danger, BadgeLook::Subtle),
        badge("New", Tone::Info, BadgeLook::Subtle),
        badge("v0.1", Tone::Neutral, BadgeLook::Subtle),
    ];
    return new Row(FlexProps { gap: 8.0, align: Align::Center }, kids);
}

/** The same badges, solid. */
fn solidRow() : Row {
    let kids : dyn Widget[] = [
        badge("Online", Tone::Ok, BadgeLook::Solid),
        badge("3 warnings", Tone::Warn, BadgeLook::Solid),
        badge("Beta", Tone::Accent, BadgeLook::Solid),
        badge("Offline", Tone::Danger, BadgeLook::Solid),
        badge("New", Tone::Info, BadgeLook::Solid),
        new Badge(
            BadgeProps {
                text: "Live",
                tone: Tone::Ok,
                size: BadgeSize::Lg,
                dot: true,
            }
        ),
    ];
    return new Row(FlexProps { gap: 8.0, align: Align::Center }, kids);
}

/** The spinner and what it is waiting for. */
fn working() : Row {
    let kids : dyn Widget[] = [
        new Spinner(ControlSize::Md),
        new Label("Working on it…", TextRole::Dim),
    ];
    return new Row(FlexProps { gap: 12.0, align: Align::Center }, kids);
}

/** The whole card. */
pub fn statusCard(progress : Shared<Model<f64>>) : Panel {
    let prose = new Label(
        LabelProps {
            role: TextRole::Dim,
            wrap: true,
        },
        "Text is set in a role, wraps to the width it is offered, and is drawn from a real font — outlines parsed from the file and rasterised here, with kerning and quarter-pixel positions."
    );
    let kids : dyn Widget[] = [
        new Label("Status", TextRole::H3),
        subtleRow(),
        solidRow(),
        new Divider(),
        new Label("Upload progress", TextRole::Label),
        new ProgressBar(progress),
        working(),
        new Divider(),
        prose,
        new Label("let mut total = 42;", TextRole::Mono),
    ];
    return new Panel(
        PanelProps {
            elevation: Elevation::Raised,
            grow: 1.0,
        },
        new Column(FlexProps { gap: 18.0 }, kids)
    );
}
