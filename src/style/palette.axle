// palette — the tokens: every colour and every measure a theme is made of.
//
// A token is a named value with one job ("the colour of text that is not the main text", "the
// radius of a small control"), and a widget asks for the job, never for the value. Changing a token
// restyles everything that uses it; adding a theme is writing one more `Palette` and, if the shape
// differs, one more `Metrics`. Nothing in a widget names a colour.
//
// The dark palette is a cool near-black with one periwinkle accent. Surfaces are told apart by a
// step of lightness and a hairline rather than by contrast, so a window stays calm until something
// in it is red; the only saturated inks are the accent and the three tones.

use crate::gfx::tint::Tint;

/** The colours of a theme. */
pub struct Palette {
    /** The page. */
    pub background : Tint;

    /** A card, a panel: one step above the page. */
    pub surface : Tint;

    /** A control's resting surface, a hovered row: one step above a card. */
    pub raised : Tint;

    /** A menu, a popover, a dialog: above everything. */
    pub overlay : Tint;

    /** A hairline between surfaces. */
    pub line : Tint;

    /** A control's outline, a divider that must be seen. */
    pub lineStrong : Tint;

    /** The main text. */
    pub text : Tint;

    /** Secondary text: labels, supporting figures. */
    pub textDim : Tint;

    /** Tertiary text: placeholders, units, hints. */
    pub textFaint : Tint;

    /** The accent: selection, focus, the primary action. */
    pub accent : Tint;

    /** The accent's lighter end — the top of a primary button, a hovered link. */
    pub accentTop : Tint;

    /** The accent's darker end — the bottom of a primary button, a pressed one. */
    pub accentBottom : Tint;

    /** The accent as a wash: a selected row's fill, a focus halo. */
    pub accentSoft : Tint;

    /** Text on an accent or tone fill. */
    pub onAccent : Tint;

    /** Good news. */
    pub ok : Tint;

    /** Caution. */
    pub warn : Tint;

    /** Trouble: also the fill of a destructive button. */
    pub danger : Tint;

    /** The dimming behind a modal dialog. */
    pub scrim : Tint;

    /** The colour shadows are cast in. */
    pub shadow : Tint;

    /** The dark theme. */
    pub static fn dark() : Palette {
        return Palette {
            background: Tint::hex(0x0E1015),
            surface: Tint::hex(0x151821),
            raised: Tint::hex(0x1C2029),
            overlay: Tint::hex(0x202530),
            line: Tint::hex(0x272C37),
            lineStrong: Tint::hex(0x3A4152),
            text: Tint::hex(0xE8EBF1),
            textDim: Tint::hex(0x9AA3B5),
            textFaint: Tint::hex(0x69718A),
            accent: Tint::hex(0x6B7DFF),
            accentTop: Tint::hex(0x8294FF),
            accentBottom: Tint::hex(0x5A6BF2),
            accentSoft: Tint::hexA(0x6B7DFF, 40),
            onAccent: Tint::hex(0xFFFFFF),
            ok: Tint::hex(0x3DD68C),
            warn: Tint::hex(0xF2B84B),
            danger: Tint::hex(0xEF4B5C),
            scrim: Tint::hexA(0x05060A, 170),
            shadow: Tint::hexA(0x000000, 255),
        };
    }

    /** The light theme. */
    pub static fn light() : Palette {
        return Palette {
            background: Tint::hex(0xF3F4F8),
            surface: Tint::hex(0xFFFFFF),
            raised: Tint::hex(0xF6F7FA),
            overlay: Tint::hex(0xFFFFFF),
            line: Tint::hex(0xE3E6EE),
            lineStrong: Tint::hex(0xCBD0DC),
            text: Tint::hex(0x161A24),
            textDim: Tint::hex(0x5A6377),
            textFaint: Tint::hex(0x8991A4),
            accent: Tint::hex(0x5565F0),
            accentTop: Tint::hex(0x6B7CFF),
            accentBottom: Tint::hex(0x4A5AE6),
            accentSoft: Tint::hexA(0x5565F0, 30),
            onAccent: Tint::hex(0xFFFFFF),
            ok: Tint::hex(0x1FA971),
            warn: Tint::hex(0xC98A12),
            danger: Tint::hex(0xD93B4A),
            scrim: Tint::hexA(0x0B0E1A, 120),
            shadow: Tint::hexA(0x1E2A50, 255),
        };
    }
}

/** The measures of a theme, in logical pixels. */
pub struct Metrics {
    /** Corner radius of a small control (a checkbox, a chip's inner mark). */
    pub radiusSm : f64 = 6.0;

    /** Corner radius of a control (a button, a field). */
    pub radiusMd : f64 = 10.0;

    /** Corner radius of a card, a dialog. */
    pub radiusLg : f64 = 14.0;

    /** A radius so large it makes a pill. */
    pub radiusFull : f64 = 999.0;

    /** The spacing unit: every gap in a layout is a multiple of it. */
    pub unit : f64 = 4.0;

    /** Height of a small control. */
    pub controlSm : f64 = 28.0;

    /** Height of a control. */
    pub controlMd : f64 = 36.0;

    /** Height of a large control. */
    pub controlLg : f64 = 44.0;

    /** Text size of a small control. */
    pub fontSm : f64 = 12.0;

    /** Text size of body copy and controls. */
    pub fontMd : f64 = 14.0;

    /** Text size of large controls and lead paragraphs. */
    pub fontLg : f64 = 16.0;

    /** Text size of a third-level heading. */
    pub fontH3 : f64 = 18.0;

    /** Text size of a second-level heading. */
    pub fontH2 : f64 = 24.0;

    /** Text size of a first-level heading. */
    pub fontH1 : f64 = 32.0;

    /** Line height as a multiple of text size, for wrapped text. */
    pub leading : f64 = 1.45;

    /** Width of a hairline. */
    pub hairline : f64 = 1.0;

    /** Width of the focus ring. */
    pub ring : f64 = 2.0;

    /** The standard metrics. */
    pub static fn standard() : Metrics {
        return Metrics { };
    }

    /** `n` spacing units. */
    pub fn space(self, n : f64) : f64 {
        return self.unit * n;
    }
}
