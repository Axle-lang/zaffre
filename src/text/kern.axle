// kern — pair kerning from the font's GPOS table.
//
// Only what a UI face needs: the PairPos lookups of the `kern` feature, format 1 (glyph pairs)
// and format 2 (class pairs), reached directly or through an Extension lookup. No script or
// language selection, no contextual lookups, no mark positioning. The answer is the first glyph's
// advance adjustment, in design units, and 0 for a font that has none.
//
// Checked against HarfBuzz on every pair of 80 characters in all three bundled fonts
// (`tools/c_ref/check_kern.py`), which is where the ordering rule below — the first subtable that
// covers the first glyph and has an answer wins — comes from.
//
// The Axle twin of `tools/c_ref/zf_gpos.h`.

use crate::text::ttf::Ttf;

/** Kerning lookups on a font. */
pub class Kern {
    /** Coverage index of glyph `g` in the table at `off`, or -1. */
    pub(file) static fn coverage(t : Ttf, off : i32, g : i32) : i32 {
        let fmt : i32 = t.wordAt(off);
        let n : i32 = t.wordAt(off + 2);
        let mut lo : i32 = 0;
        let mut hi : i32 = n - 1;
        if (fmt == 1) {
            while (lo <= hi) {
                let mid : i32 = (lo + hi) / 2;
                let v : i32 = t.wordAt(off + 4 + mid * 2);
                if (v == g) {
                    return mid;
                }
                if (v < g) {
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
            return -1;
        }
        if (fmt == 2) {
            while (lo <= hi) {
                let mid : i32 = (lo + hi) / 2;
                let r : i32 = off + 4 + mid * 6;
                let s : i32 = t.wordAt(r);
                let e : i32 = t.wordAt(r + 2);
                if (g < s) {
                    hi = mid - 1;
                } else if (g > e) {
                    lo = mid + 1;
                } else {
                    return t.wordAt(r + 4) + (g - s);
                }
            }
        }
        return -1;
    }

    /** The class of glyph `g` in the class definition at `off` (0 when it has none). */
    pub(file) static fn classOf(t : Ttf, off : i32, g : i32) : i32 {
        let fmt : i32 = t.wordAt(off);
        if (fmt == 1) {
            let start : i32 = t.wordAt(off + 2);
            let n : i32 = t.wordAt(off + 4);
            if (g >= start && g < start + n) {
                return t.wordAt(off + 6 + (g - start) * 2);
            }
            return 0;
        }
        if (fmt == 2) {
            let n : i32 = t.wordAt(off + 2);
            let mut lo : i32 = 0;
            let mut hi : i32 = n - 1;
            while (lo <= hi) {
                let mid : i32 = (lo + hi) / 2;
                let r : i32 = off + 4 + mid * 6;
                let s : i32 = t.wordAt(r);
                let e : i32 = t.wordAt(r + 2);
                if (g < s) {
                    hi = mid - 1;
                } else if (g > e) {
                    lo = mid + 1;
                } else {
                    return t.wordAt(r + 4);
                }
            }
        }
        return 0;
    }

    /** Set bits in `v`. */
    pub(file) static fn bits(v : i32) : i32 {
        let mut c : i32 = 0;
        let mut x : i32 = v;
        while (x != 0) {
            c = c + (x & 1);
            x = x >>> 1;
        }
        return c;
    }

    /** The XAdvance of the value record at `off`, laid out as `fmt` says, or 0 when it has none. */
    pub(file) static fn xAdvance(t : Ttf, off : i32, fmt : i32) : i32 {
        if ((fmt & 4) == 0) {
            return 0;
        }
        return t.swordAt(off + Kern::bits(fmt & 3) * 2);
    }

    /** Whether the PairPos subtable at `sub` has an answer for (`a`, `b`); the answer is in `.value`. */
    pub(file) static fn pair(t : Ttf, sub : i32, a : i32, b : i32) : (found: bool, value: i32) {
        let fmt : i32 = t.wordAt(sub);
        let ci : i32 = Kern::coverage(t, sub + t.wordAt(sub + 2), a);
        if (ci < 0) {
            return (false, 0);
        }
        let vf1 : i32 = t.wordAt(sub + 4);
        let vf2 : i32 = t.wordAt(sub + 6);
        let s1 : i32 = Kern::bits(vf1) * 2;
        let s2 : i32 = Kern::bits(vf2) * 2;
        if (fmt == 1) {
            let set : i32 = sub + t.wordAt(sub + 10 + ci * 2);
            let n : i32 = t.wordAt(set);
            let rec : i32 = s1 + s2 + 2;
            let mut lo : i32 = 0;
            let mut hi : i32 = n - 1;
            while (lo <= hi) {
                let mid : i32 = (lo + hi) / 2;
                let r : i32 = set + 2 + mid * rec;
                let sg : i32 = t.wordAt(r);
                if (sg == b) {
                    return (true, Kern::xAdvance(t, r + 2, vf1));
                }
                if (sg < b) {
                    lo = mid + 1;
                } else {
                    hi = mid - 1;
                }
            }
            return (false, 0);
        }
        if (fmt == 2) {
            let c1 : i32 = Kern::classOf(t, sub + t.wordAt(sub + 8), a);
            let c2 : i32 = Kern::classOf(t, sub + t.wordAt(sub + 10), b);
            let n1 : i32 = t.wordAt(sub + 12);
            let n2 : i32 = t.wordAt(sub + 14);
            if (c1 >= n1 || c2 >= n2) {
                return (false, 0);
            }
            let rec : i32 = s1 + s2;
            return (true, Kern::xAdvance(t, sub + 16 + (c1 * n2 + c2) * rec, vf1));
        }
        return (false, 0);
    }

    /** The kerning between glyphs `a` and `b`, in design units; 0 when the font has none. */
    pub static fn between(t : Ttf, a : i32, b : i32) : i32 {
        if (t.gpos == 0) {
            return 0;
        }
        let g : i32 = t.gpos;
        let feats : i32 = g + t.wordAt(g + 6);
        let lookups : i32 = g + t.wordAt(g + 8);
        let nf : i32 = t.wordAt(feats);
        for (i of 0..nf) {
            let rec : i32 = feats + 2 + i * 6;
            // 'kern'
            if (t.byteAt(rec) != 107 || t.byteAt(rec + 1) != 101 || t.byteAt(rec + 2) != 114 || t.byteAt(rec + 3) != 110) {
                continue;
            }
            let ft : i32 = feats + t.wordAt(rec + 4);
            let nl : i32 = t.wordAt(ft + 2);
            for (k of 0..nl) {
                let li : i32 = t.wordAt(ft + 4 + k * 2);
                let lk : i32 = lookups + t.wordAt(lookups + 2 + li * 2);
                let kind : i32 = t.wordAt(lk);
                let ns : i32 = t.wordAt(lk + 4);
                for (s of 0..ns) {
                    let mut sub : i32 = lk + t.wordAt(lk + 6 + s * 2);
                    let mut st : i32 = kind;
                    if (kind == 9) {
                        st = t.wordAt(sub + 2);
                        sub = sub + (t.dwordAt(sub + 4) as i32);
                    }
                    if (st != 2) {
                        continue;
                    }
                    let (found, value) = Kern::pair(t, sub, a, b);
                    if (found) {
                        return value;
                    }
                }
            }
        }
        return 0;
    }
}
