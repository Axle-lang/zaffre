// toolbar — a row of icon buttons for the actions of an editor, with groups and toggles.
//
//     let items : ToolbarItem[] = [
//         ToolbarItem { icon: IconKind::Edit, tip: "Edit" },
//         ToolbarItem { icon: IconKind::Copy, tip: "Copy" },
//         ToolbarItem { separator: true },
//         ToolbarItem { icon: IconKind::Star, tip: "Favourite", toggle: true },
//     ];
//     new Toolbar(items, marks, (i) => act(i))
//
// Each item is a square ghost button. A `toggle` item stays pressed (drawn on the hover wash, in the
// main text colour) while its bit is set in the model, a bit mask indexed by position in the array;
// the others just run the handler with their index. Hovering an item for a moment shows its tip.

use crate::gfx::mathx::Mathx;
use crate::gfx::tint::Tint;
use crate::gfx::shapes::{RRect, Brush};
use crate::text::fonts::FaceKind;
use crate::core::geometry::{Size, Bounds, Limits};
use crate::core::event::{UiEvent, EventKind};
use crate::core::context::{Context, Cursor};
use crate::core::model::Model;
use crate::core::widget::{Widget, Control, Gesture};
use crate::paint::painter::Painter;
use crate::widgets::icon::{IconKind, Icons};

/** One entry of a toolbar. */
pub struct ToolbarItem {
    /** The picture. */
    pub icon : IconKind = IconKind::None;

    /** A few words shown when the pointer rests on it. */
    pub tip : string = "";

    /** Whether it is a hairline between groups rather than a button. */
    pub separator : bool = false;

    /** Whether it stays pressed. */
    pub toggle : bool = false;

    /** Whether it is switched off. */
    pub disabled : bool = false;
}

/** Side of a button. */
const TOOL_SIDE : f64 = 32.0;

/** Space between entries. */
const TOOL_GAP : f64 = 2.0;

/** Seconds the pointer rests before a tip shows. */
const TOOL_DELAY : f64 = 0.5;

/** The handler a toolbar without one runs. */
fn ignoreTool(i : i32) : void {
}

/** A row of tool buttons. */
pub class Toolbar : Control, Widget {
    items : ToolbarItem[];
    count : i32;
    marks : Shared<Model<i32>>;
    onPick : (i32) => void;
    lefts : f64[];
    hot : i32 = -1;
    since : f64 = 0.0;

    /** A toolbar of `items`; `marks` holds which toggles are pressed; `onPick` is told the index of a press. */
    constructor(items : ToolbarItem[], marks : Shared<Model<i32>>, onPick : (i32) => void) {
        super();
        self.items = items;
        self.count = items.length as i32;
        self.marks = marks;
        self.onPick = onPick;
        self.lefts = malloc<f64>(self.count as i64);
        self.focusable = false;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let mut x : f64 = 8.0;
        for (i of 0..self.count) {
            self.lefts[i as i64] = x;
            if (self.items[i as i64].separator) {
                x = x + 13.0;
            } else {
                x = x + TOOL_SIDE + TOOL_GAP;
            }
        }
        return limits.constrain(Size { w: x + 6.0, h: TOOL_SIDE + 16.0 });
    }

    /** The button under `x`, or -1. */
    pub(file) fn buttonAt(self, x : f64, y : f64) : i32 {
        if (y < self.area.y + 8.0 || y >= self.area.y + 8.0 + TOOL_SIDE) {
            return -1;
        }
        for (i of 0..self.count) {
            if (self.items[i as i64].separator) {
                continue;
            }
            let left : f64 = self.area.x + self.lefts[i as i64];
            if (x >= left && x < left + TOOL_SIDE) {
                return i;
            }
        }
        return -1;
    }

    pub fn event(mut self, ctx : Context, e : UiEvent) : bool {
        let g : Gesture = self.pointer(ctx, e);
        if (e.kind == EventKind::PointerMove) {
            let before : i32 = self.hot;
            self.hot = -1;
            if (self.hovered) {
                self.hot = self.buttonAt(e.x, e.y);
                if (self.hot >= 0 && !self.items[self.hot as i64].disabled) {
                    ctx.wantCursor(Cursor::Hand);
                }
            }
            if (before != self.hot) {
                self.since = ctx.now;
                ctx.wakeIn(TOOL_DELAY + 0.02);
                ctx.invalidate();
            }
        }
        if (g == Gesture::Click) {
            let i : i32 = self.buttonAt(e.x, e.y);
            if (i >= 0 && !self.items[i as i64].disabled) {
                if (self.items[i as i64].toggle) {
                    self.marks.set(self.marks.get() ^ (1 << i));
                }
                let h : (i32) => void = self.onPick;
                h(i);
                ctx.invalidate();
                return true;
            }
        }
        return g == Gesture::Press && self.buttonAt(e.x, e.y) >= 0;
    }

    pub fn tick(mut self, ctx : Context, dt : f64) : bool {
        if (self.hot >= 0 && ctx.now - self.since < TOOL_DELAY) {
            ctx.wakeIn(TOOL_DELAY - (ctx.now - self.since) + 0.02);
        }
        return self.animate(ctx, dt);
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let pal = ctx.theme.palette;
        let a : Bounds = self.area;
        let r : f64 = ctx.theme.metrics.radiusControl;
        p.fillRound(a.round(r), Brush::solid(pal.surface.rgb, pal.surface.a));
        p.strokeRound(a.round(r), 1.0, Brush::solid(pal.line.rgb, pal.line.a));
        let mask : i32 = self.marks.get();
        for (i of 0..self.count) {
            let item : ToolbarItem = self.items[i as i64];
            let left : f64 = a.x + self.lefts[i as i64];
            if (item.separator) {
                p.line(left + 6.0, a.y + 14.0, left + 6.0, a.bottom() - 14.0, 1.0, pal.line);
                continue;
            }
            let box : Bounds = Bounds::make(left, a.y + 8.0, TOOL_SIDE, TOOL_SIDE);
            let on : bool = item.toggle && ((mask >> i) & 1) == 1;
            let mut ink : Tint = pal.textDim;
            if (item.disabled) {
                ink = pal.textOff;
            } else if (on) {
                p.fillRound(box.round(ctx.theme.metrics.radiusInline), Brush::solid(pal.hover.rgb, pal.hover.a));
                ink = pal.text;
            } else if (i == self.hot) {
                p.fillRound(box.round(ctx.theme.metrics.radiusInline), Brush::solid(pal.hover.rgb, pal.hover.a));
                ink = pal.text;
            }
            Icons::draw(p, item.icon, box.midX() - 8.0, box.midY() - 8.0, 16.0, ink);
        }
        // The tip, once the pointer has rested.
        if (self.hot >= 0 && ctx.now - self.since >= TOOL_DELAY && self.items[self.hot as i64].tip.byteLength > 0) {
            let tip : string = self.items[self.hot as i64].tip;
            let w : f64 = ctx.textWidth(FaceKind::Medium, tip, 12.0) + 20.0;
            let x : f64 = a.x + self.lefts[self.hot as i64] + TOOL_SIDE * 0.5 - w * 0.5;
            let box : Bounds = Bounds::make(x, a.bottom() + 6.0, w, 26.0);
            let rr : RRect = box.round(ctx.theme.metrics.radiusInline);
            p.fillRound(rr, Brush::solid(pal.inverse.rgb, pal.inverse.a));
            p.text(FaceKind::Medium, tip, box.x + 10.0, ctx.baselineIn(FaceKind::Medium, 12.0, box.y, box.h), 12.0, pal.inverseText);
        }
    }
}
