// toast — a message that appears, stays a few seconds and goes by itself.
//
//     openToast(ctx, "Saved", Tone::Ok);
//
// A toast is an overlay at the bottom centre of the interface: a rounded card with the tone's icon
// and the message. Several stack upward, oldest at the bottom, and each moves down as the ones
// beneath it go. It leaves after a few seconds, or when it is clicked; nothing else about the page
// stops for it, and a press anywhere else reaches the page as it would without one.

use crate::gfx::mathx::Mathx;
use crate::gfx::tint::Tint;
use crate::gfx::shapes::{RRect, Brush};
use crate::style::ease::{Eased, Rate};
use crate::style::palette::Soft;
use crate::style::variants::{Tone, Elevation};
use crate::text::fonts::FaceKind;
use crate::core::geometry::{Size, Bounds, Limits};
use crate::core::event::{UiEvent, EventKind};
use crate::core::context::Context;
use crate::core::widget::{Widget, Base};
use crate::paint::painter::Painter;
use crate::widgets::alert::Alert;
use crate::widgets::panel::Surfaces;
use crate::widgets::icon::{IconKind, Icons};

/** Seconds a toast stays when not clicked. */
const TOAST_SECONDS : f64 = 4.0;

/** The card's width: as much as the window leaves, up to this. */
const TOAST_WIDTH : f64 = 360.0;

/** Space between the card and the window's corner. */
const TOAST_MARGIN : f64 = 16.0;

/** Space between the card's edge and its content. */
const TOAST_PAD : f64 = 14.0;

/** Diameter of the disc that holds the tone's icon. */
const TOAST_DISC : f64 = 32.0;

/** Space between the disc and the text, and between the text and the cross. */
const TOAST_GAP : f64 = 12.0;

/** Sizes of the title and of the line under it. */
const TOAST_PX : f64 = 14.0;
const TOAST_DETAIL_PX : f64 = 13.0;

/** A toast overlay. */
pub class Toast : Base, Widget {
    text : string;
    detail : string;
    tone : Tone;
    id : i64 = 0;
    born : f64 = -1.0;
    openT : Eased = Eased::at(0.0);
    closing : bool = false;
    finished : bool = false;
    sheet : Bounds = Bounds::zero();

    /** A toast saying `text` in `tone`. */
    constructor(text : string, tone : Tone) {
        self.text = text;
        self.detail = "";
        self.tone = tone;
    }

    /** A toast with a title and a line of detail under it. */
    constructor(text : string, detail : string, tone : Tone) {
        self.text = text;
        self.detail = detail;
        self.tone = tone;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        return Size { w: limits.maxW, h: limits.maxH };
    }

    /** The card's height: the disc alone for a title, the two lines of text with a detail. */
    pub(file) fn cardHeight(self, ctx : Context) : f64 {
        let mut content : f64 = TOAST_DISC;
        if (self.detail.byteLength > 0) {
            content = ctx.lineHeight(FaceKind::Bold, TOAST_PX) + 2.0 + ctx.lineHeight(FaceKind::Sans, TOAST_DETAIL_PX);
        }
        return 2.0 * TOAST_PAD + Mathx::fmax(content, TOAST_DISC);
    }

    pub fn arrange(mut self, ctx : Context, area : Bounds) : void {
        self.area = area;
        let h : f64 = self.cardHeight(ctx);
        if (self.id == 0 && !self.finished) {
            self.id = ctx.toastJoin(h);
            if (self.id == 0) {
                // Eight are already up: this one is not shown.
                self.finished = true;
                return;
            }
        }
        let w : f64 = Mathx::fmin(area.w - 2.0 * TOAST_MARGIN, TOAST_WIDTH);
        let y : f64 = area.bottom() - TOAST_MARGIN - h - ctx.toastRise(self.id);
        self.sheet = Bounds::make(area.right() - TOAST_MARGIN - w, y, w, h);
    }

    /** The box of the cross that dismisses the toast. */
    pub(file) fn crossBox(self) : Bounds {
        return Bounds::make(self.sheet.right() - TOAST_PAD - 16.0, self.sheet.y + TOAST_PAD + 8.0, 16.0, 16.0);
    }

    pub fn covers(self, x : f64, y : f64) : bool {
        return !self.finished && self.sheet.contains(x, y);
    }

    pub fn done(self) : bool {
        return self.finished;
    }

    pub fn event(mut self, ctx : Context, e : UiEvent) : bool {
        if (e.kind == EventKind::PointerDown && !self.closing && self.sheet.contains(e.x, e.y)) {
            self.closing = true;
            ctx.invalidate();
            return true;
        }
        return false;
    }

    pub fn tick(mut self, ctx : Context, dt : f64) : bool {
        if (self.finished) {
            return false;
        }
        if (self.born < 0.0) {
            self.born = ctx.now;
        }
        if (!self.closing) {
            let left : f64 = TOAST_SECONDS - (ctx.now - self.born);
            if (left <= 0.0) {
                self.closing = true;
            } else {
                ctx.wakeIn(left);
            }
        }
        let mut t : f64 = 1.0;
        if (self.closing) {
            t = 0.0;
        }
        self.openT = self.openT.toward(t).step(dt, Rate::OPEN * 1.4);
        if (self.closing && self.openT.settled()) {
            self.finished = true;
            ctx.toastLeave(self.id);
            ctx.invalidate();
            return false;
        }
        return !self.openT.settled();
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        if (self.finished) {
            return;
        }
        let pal = ctx.theme.palette;
        let soft : Soft = ctx.theme.soft(self.tone);
        let k : f64 = Mathx::smooth(self.openT.value);
        let prev : i32 = p.setOpacity(Mathx::roundI(k * 255.0));
        let b : Bounds = self.sheet.moved((1.0 - k) * 28.0, 0.0);
        Surfaces::draw(p, b.round(ctx.theme.metrics.radiusSurface), b, ctx.theme.panel(Elevation::Floating));
        // The tone sits in a soft disc, as in a web toast.
        let disc : Bounds = Bounds::make(b.x + TOAST_PAD, b.y + TOAST_PAD, TOAST_DISC, TOAST_DISC);
        p.fillRound(disc.round(TOAST_DISC * 0.5), Brush::solid(soft.fill.rgb, soft.fill.a));
        Icons::draw(p, Alert::iconOf(self.tone), disc.midX() - 9.0, disc.midY() - 9.0, 18.0, soft.fg);
        let left : f64 = disc.right() + TOAST_GAP;
        let room : f64 = b.right() - TOAST_PAD - 16.0 - TOAST_GAP - left;
        if (self.detail.byteLength > 0) {
            let line : f64 = ctx.lineHeight(FaceKind::Bold, TOAST_PX);
            p.textElided(FaceKind::Bold, self.text, left, ctx.baselineIn(FaceKind::Bold, TOAST_PX, b.y + TOAST_PAD, line), TOAST_PX, room, pal.text);
            let top : f64 = b.y + TOAST_PAD + line + 2.0;
            let detailLine : f64 = ctx.lineHeight(FaceKind::Sans, TOAST_DETAIL_PX);
            p.textElided(FaceKind::Sans, self.detail, left, ctx.baselineIn(FaceKind::Sans, TOAST_DETAIL_PX, top, detailLine), TOAST_DETAIL_PX, room, pal.textDim);
        } else {
            p.textElided(FaceKind::Bold, self.text, left, ctx.baselineIn(FaceKind::Bold, TOAST_PX, disc.y, disc.h), TOAST_PX, room, pal.text);
        }
        let cross : Bounds = self.crossBox().moved((1.0 - k) * 28.0, 0.0);
        let hot : bool = cross.grown(4.0).contains(ctx.pointerX, ctx.pointerY);
        Icons::draw(p, IconKind::Close, cross.x + 1.0, cross.y + 1.0, 14.0, hot ? pal.text : pal.textFaint);
        p.setOpacity(prev);
    }
}

/** Show a toast; false when the interface has no room for another overlay. */
pub fn openToast(ctx : Context, text : string, tone : Tone) : bool {
    return ctx.openOverlay(new Toast(text, tone));
}
