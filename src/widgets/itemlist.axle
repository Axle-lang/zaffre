// itemlist — rows of a title with a line under it, an icon before and a note after.
//
//     let people : ListEntry[] = [
//         ListEntry { title: "Ada Lovelace", subtitle: "Mathematician", note: "online", icon: IconKind::User },
//         ListEntry { title: "Grace Hopper", subtitle: "Rear admiral", note: "away", icon: IconKind::User },
//     ];
//     new ItemList(ItemListProps { }, people, chosen)
//
// A list is a column of rows divided by hairlines, inside a bordered surface. Rows light up under
// the pointer; with a model, the one that was clicked is held in it (-1 for none) and drawn in the
// brand wash. `DescriptionList` is its quiet cousin: a term on the left, a value on the right,
// for the facts about one thing.

use crate::gfx::mathx::Mathx;
use crate::gfx::tint::Tint;
use crate::gfx::shapes::{RRect, Brush};
use crate::text::fonts::FaceKind;
use crate::core::geometry::{Size, Bounds, Limits, Length};
use crate::core::event::{UiEvent, EventKind};
use crate::core::context::{Context, Cursor};
use crate::core::model::Model;
use crate::core::widget::{Widget, Control, Gesture, Base};
use crate::paint::painter::Painter;
use crate::widgets::icon::{IconKind, Icons};

/** One row of a list. */
pub struct ListEntry {
    /** The main line. */
    pub title : string = "";

    /** A line under the title, in a quieter colour. */
    pub subtitle : string = "";

    /** Text at the far end of the row. */
    pub note : string = "";

    /** A picture in a soft disc before the title. */
    pub icon : IconKind = IconKind::None;
}

/** How a list looks. */
pub struct ItemListProps {
    /** Whether the list is drawn inside a bordered surface. */
    pub framed : bool = true;

    /** Whether rows can be picked. */
    pub selectable : bool = true;

    /** The list's width: its content's, a fixed number, or as much as it is offered. */
    pub width : Length = Length::Fill;
}

/** Height of a row with one line. */
const ROW_ONE : f64 = 52.0;

/** Height of a row with two lines. */
const ROW_TWO : f64 = 64.0;

/** The handler a list without one runs. */
fn ignoreItem(i : i32) : void {
}

/** A column of rows. */
pub class ItemList : Control, Widget {
    props : ItemListProps;
    entries : ListEntry[];
    count : i32;
    picked : Shared<Model<i32>>;
    onPick : (i32) => void = ignoreItem;
    hot : i32 = -1;

    /** A list of `entries` whose picked row is held in `picked`. */
    constructor(own props : ItemListProps, entries : ListEntry[], picked : Shared<Model<i32>>) {
        super();
        self.props = props;
        self.entries = entries;
        self.count = entries.length as i32;
        self.picked = picked;
        self.focusable = false;
    }

    /** As above, telling `onPick` the index when a row is clicked. */
    constructor(own props : ItemListProps, entries : ListEntry[], picked : Shared<Model<i32>>, onPick : (i32) => void) {
        super();
        self.props = props;
        self.entries = entries;
        self.count = entries.length as i32;
        self.picked = picked;
        self.onPick = onPick;
        self.focusable = false;
    }

    /** The height of row `i`. */
    pub(file) fn rowHeight(self, i : i32) : f64 {
        if (self.entries[i as i64].subtitle.byteLength > 0) {
            return ROW_TWO;
        }
        return ROW_ONE;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let mut h : f64 = 0.0;
        let mut w : f64 = 0.0;
        for (i of 0..self.count) {
            h = h + self.rowHeight(i);
            let e : ListEntry = self.entries[i as i64];
            let mut rw : f64 = 32.0 + ctx.textWidth(FaceKind::Bold, e.title, 14.0) + ctx.textWidth(FaceKind::Sans, e.note, 13.0) + 64.0;
            if (e.icon != IconKind::None) {
                rw = rw + 52.0;
            }
            w = Mathx::fmax(w, rw);
        }
        return limits.constrain(Size { w: self.props.width.resolve(limits.maxW, w), h: h });
    }

    /** The row under `y`, or -1. */
    pub(file) fn rowAt(self, y : f64) : i32 {
        let mut top : f64 = self.area.y;
        for (i of 0..self.count) {
            let h : f64 = self.rowHeight(i);
            if (y >= top && y < top + h) {
                return i;
            }
            top = top + h;
        }
        return -1;
    }

    pub fn event(mut self, ctx : Context, e : UiEvent) : bool {
        let g : Gesture = self.pointer(ctx, e);
        if (e.kind == EventKind::PointerMove) {
            self.hot = -1;
            if (self.hovered) {
                self.hot = self.rowAt(e.y);
                if (self.props.selectable) {
                    ctx.wantCursor(Cursor::Hand);
                }
            }
        }
        if (g == Gesture::Click && self.props.selectable) {
            let i : i32 = self.rowAt(e.y);
            if (i >= 0) {
                self.picked.set(i);
                let h : (i32) => void = self.onPick;
                h(i);
                ctx.invalidate();
                return true;
            }
        }
        return g == Gesture::Press && self.props.selectable;
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let pal = ctx.theme.palette;
        let a : Bounds = self.area;
        let r : f64 = ctx.theme.metrics.radiusSurface;
        if (self.props.framed) {
            p.fillRound(a.round(r), Brush::solid(pal.surface.rgb, pal.surface.a));
        }
        let mut top : f64 = a.y;
        for (i of 0..self.count) {
            let e : ListEntry = self.entries[i as i64];
            let h : f64 = self.rowHeight(i);
            let last : bool = i == self.count - 1;
            let first : bool = i == 0;
            let tr : f64 = (first && self.props.framed) ? r : 0.0;
            let br : f64 = (last && self.props.framed) ? r : 0.0;
            let shape : RRect = RRect::corners(a.x, top, a.w, h, tr, tr, br, br);
            if (i == self.picked.get() && self.props.selectable) {
                p.fillRound(shape, Brush::solid(pal.softPrimary.fill.rgb, pal.softPrimary.fill.a));
            } else if (i == self.hot && self.props.selectable) {
                p.fillRound(shape, Brush::solid(pal.hover.rgb, pal.hover.a));
            }
            let mut x : f64 = a.x + 16.0;
            if (e.icon != IconKind::None) {
                let disc : RRect = RRect::uniform(x, top + (h - 36.0) * 0.5, 36.0, 36.0, 18.0);
                p.fillRound(disc, Brush::solid(pal.softPrimary.fill.rgb, pal.softPrimary.fill.a));
                Icons::draw(p, e.icon, x + 9.0, top + (h - 18.0) * 0.5, 18.0, pal.softPrimary.fg);
                x = x + 52.0;
            }
            if (e.subtitle.byteLength > 0) {
                p.text(FaceKind::Bold, e.title, x, ctx.baselineIn(FaceKind::Bold, 14.0, top + 10.0, 20.0), 14.0, pal.text);
                p.text(FaceKind::Sans, e.subtitle, x, ctx.baselineIn(FaceKind::Sans, 13.0, top + 32.0, 20.0), 13.0, pal.textFaint);
            } else {
                p.text(FaceKind::Bold, e.title, x, ctx.baselineIn(FaceKind::Bold, 14.0, top, h), 14.0, pal.text);
            }
            if (e.note.byteLength > 0) {
                let w : f64 = ctx.textWidth(FaceKind::Sans, e.note, 13.0);
                p.text(FaceKind::Sans, e.note, a.right() - 16.0 - w, ctx.baselineIn(FaceKind::Sans, 13.0, top, h), 13.0, pal.textFaint);
            }
            if (!last) {
                p.line(a.x, top + h - 0.5, a.right(), top + h - 0.5, 1.0, pal.line);
            }
            top = top + h;
        }
        if (self.props.framed) {
            p.strokeRound(a.round(r), 1.0, Brush::solid(pal.line.rgb, pal.line.a));
        }
    }
}

/** Height of a row of a description list. */
const DESC_ROW : f64 = 44.0;

/** Terms on the left, details on the right. */
pub class DescriptionList : Base, Widget {
    terms : string[];
    details : string[];
    count : i32;

    /** A list of `terms`, each with the `details` at the same index. */
    constructor(terms : string[], details : string[]) {
        self.terms = terms;
        self.details = details;
        self.count = Mathx::clampI(terms.length as i32, 0, details.length as i32);
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        return limits.constrain(Size { w: limits.boundedW() ? limits.maxW : 360.0, h: DESC_ROW * (self.count as f64) });
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let pal = ctx.theme.palette;
        let a : Bounds = self.area;
        let split : f64 = a.x + Mathx::fmin(160.0, a.w * 0.4);
        for (i of 0..self.count) {
            let top : f64 = a.y + DESC_ROW * (i as f64);
            p.text(FaceKind::Sans, self.terms[i as i64], a.x, ctx.baselineIn(FaceKind::Sans, 14.0, top, DESC_ROW), 14.0, pal.textFaint);
            p.textElided(FaceKind::Sans, self.details[i as i64], split, ctx.baselineIn(FaceKind::Sans, 14.0, top, DESC_ROW), 14.0, a.right() - split, pal.text);
            if (i < self.count - 1) {
                p.line(a.x, top + DESC_ROW - 0.5, a.right(), top + DESC_ROW - 0.5, 1.0, pal.line);
            }
        }
    }
}
