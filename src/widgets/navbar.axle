// navbar — the bar across the top of a page: a brand, a few links, and actions at the far end.
//
//     let links : string[] = ["Overview", "Docs", "Pricing"];
//     new Navbar(NavbarProps { brand: "Zaffre" }, links, section, new Button("Sign in"))
//
// The model holds the index of the current link. The trailing widget — a button, a row of icon
// buttons, an avatar — is placed at the right edge, centred vertically, and receives its own
// events.

use crate::gfx::mathx::Mathx;
use crate::gfx::tint::Tint;
use crate::gfx::shapes::{RRect, Brush};
use crate::text::fonts::FaceKind;
use crate::core::geometry::{Size, Bounds, Limits};
use crate::core::event::{UiEvent, EventKind};
use crate::core::context::{Context, Cursor};
use crate::core::model::Model;
use crate::core::widget::{Widget, Base, Control, Gesture};
use crate::paint::painter::Painter;
use crate::widgets::icon::{IconKind, Icons};

/** How a navbar looks. */
pub struct NavbarProps {
    /** The brand's name, at the left. */
    pub brand : string = "";

    /** The mark beside the brand. */
    pub logo : IconKind = IconKind::Cloud;
}

/** Height of the bar. */
const NAV_HEIGHT : f64 = 64.0;

/** Space between links. */
const NAV_LINK_GAP : f64 = 4.0;

/** A top bar. */
pub class Navbar : Control, Widget {
    props : NavbarProps;
    links : string[];
    count : i32;
    model : Shared<Model<i32>>;
    trailing : dyn Widget[];
    left : f64[];
    right : f64[];
    hot : i32 = -1;

    /** A bar of `links` with `trailing` at the far end; the bar takes the widget. */
    constructor(own props : NavbarProps, links : string[], model : Shared<Model<i32>>, own trailing : dyn Widget) {
        self.props = props;
        self.links = links;
        self.count = links.length as i32;
        self.model = model;
        self.trailing = malloc<dyn Widget>(1 as i64);
        self.trailing[0] = trailing;
        self.left = malloc<f64>(self.count as i64);
        self.right = malloc<f64>(self.count as i64);
        self.focusable = false;
    }

    /** The width the brand takes, including the gap after it. */
    pub(file) fn brandWidth(self, ctx : Context) : f64 {
        return 28.0 + 12.0 + ctx.textWidth(FaceKind::Bold, self.props.brand, 16.0) + 40.0;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let mut x : f64 = 24.0 + self.brandWidth(ctx);
        for (i of 0..self.count) {
            let w : f64 = ctx.textWidth(FaceKind::Bold, self.links[i as i64], 14.0) + 20.0;
            self.left[i as i64] = x;
            self.right[i as i64] = x + w;
            x = x + w + NAV_LINK_GAP;
        }
        let t : dyn Widget = self.trailing[0];
        t.measure(ctx, Limits::loose(limits.maxW, NAV_HEIGHT));
        return limits.constrain(Size { w: limits.boundedW() ? limits.maxW : x + 200.0, h: NAV_HEIGHT });
    }

    pub fn arrange(mut self, ctx : Context, area : Bounds) : void {
        self.area = area;
        let t : dyn Widget = self.trailing[0];
        let s : Size = t.measure(ctx, Limits::loose(area.w, NAV_HEIGHT));
        t.arrange(ctx, Bounds::make(area.right() - 24.0 - s.w, area.y + (area.h - s.h) * 0.5, s.w, s.h));
    }

    /** The link under `x`, or -1. */
    pub(file) fn linkAt(self, x : f64) : i32 {
        let rel : f64 = x - self.area.x;
        for (i of 0..self.count) {
            if (rel >= self.left[i as i64] && rel < self.right[i as i64]) {
                return i;
            }
        }
        return -1;
    }

    pub fn event(mut self, ctx : Context, e : UiEvent) : bool {
        let t : dyn Widget = self.trailing[0];
        if (t.event(ctx, e)) {
            return true;
        }
        let g : Gesture = self.pointer(ctx, e);
        if (e.kind == EventKind::PointerMove) {
            self.hot = -1;
            if (self.hovered && e.y < self.area.y + NAV_HEIGHT) {
                self.hot = self.linkAt(e.x);
                if (self.hot >= 0) {
                    ctx.wantCursor(Cursor::Hand);
                }
            }
        }
        if (g == Gesture::Click) {
            let i : i32 = self.linkAt(e.x);
            if (i >= 0) {
                self.model.set(i);
                ctx.invalidate();
                return true;
            }
        }
        return g == Gesture::Press && self.linkAt(e.x) >= 0;
    }

    pub fn tick(mut self, ctx : Context, dt : f64) : bool {
        let t : dyn Widget = self.trailing[0];
        let inner : bool = t.tick(ctx, dt);
        return self.animate(ctx, dt) || inner;
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let pal = ctx.theme.palette;
        let a : Bounds = self.area;
        p.fillRound(a.round(0.0), Brush::solid(pal.surface.rgb, pal.surface.a));
        p.line(a.x, a.bottom() - 0.5, a.right(), a.bottom() - 0.5, 1.0, pal.line);
        let mark : RRect = RRect::uniform(a.x + 24.0, a.midY() - 14.0, 28.0, 28.0, ctx.theme.metrics.radiusControl);
        p.fillRound(mark, Brush::solid(pal.primary.s600.rgb, 255));
        Icons::draw(p, self.props.logo, mark.x + 4.0, mark.y + 4.0, 20.0, Tint::hex(0xFFFFFF));
        p.text(FaceKind::Bold, self.props.brand, a.x + 64.0, ctx.baselineIn(FaceKind::Bold, 16.0, a.y, a.h), 16.0, pal.text);
        let current : i32 = self.model.get();
        for (i of 0..self.count) {
            let box : Bounds = Bounds::make(a.x + self.left[i as i64], a.midY() - 16.0, self.right[i as i64] - self.left[i as i64], 32.0);
            let mut ink : Tint = pal.textDim;
            if (i == current) {
                ink = pal.text;
            } else if (i == self.hot) {
                p.fillRound(box.round(ctx.theme.metrics.radiusInline), Brush::solid(pal.hover.rgb, pal.hover.a));
                ink = pal.text;
            }
            let w : f64 = ctx.textWidth(FaceKind::Bold, self.links[i as i64], 14.0);
            p.text(FaceKind::Bold, self.links[i as i64], box.x + (box.w - w) * 0.5, ctx.baselineIn(FaceKind::Bold, 14.0, box.y, box.h), 14.0, ink);
        }
        let t : dyn Widget = self.trailing[0];
        t.paint(ctx, p);
    }
}

/** The bar over the content of an application: the name of the current page, and `trailing` at the far end. */
pub class TopBar : Base, Widget {
    names : string[];
    model : Shared<Model<i32>>;
    trailing : dyn Widget[];

    /** A bar titled with `names[model]`, with `trailing` at the right; the bar takes the widget. */
    constructor(names : string[], model : Shared<Model<i32>>, own trailing : dyn Widget) {
        self.names = names;
        self.model = model;
        self.trailing = malloc<dyn Widget>(1 as i64);
        self.trailing[0] = trailing;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let t : dyn Widget = self.trailing[0];
        t.measure(ctx, Limits::loose(limits.maxW, NAV_HEIGHT));
        return limits.constrain(Size { w: limits.boundedW() ? limits.maxW : 480.0, h: NAV_HEIGHT });
    }

    pub fn arrange(mut self, ctx : Context, area : Bounds) : void {
        self.area = area;
        let t : dyn Widget = self.trailing[0];
        let s : Size = t.measure(ctx, Limits::loose(area.w, NAV_HEIGHT));
        t.arrange(ctx, Bounds::make(area.right() - 24.0 - s.w, area.y + (area.h - s.h) * 0.5, s.w, s.h));
    }

    pub fn event(mut self, ctx : Context, e : UiEvent) : bool {
        let t : dyn Widget = self.trailing[0];
        return t.event(ctx, e);
    }

    pub fn tick(mut self, ctx : Context, dt : f64) : bool {
        let t : dyn Widget = self.trailing[0];
        return t.tick(ctx, dt);
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let pal = ctx.theme.palette;
        let a : Bounds = self.area;
        p.fillRound(a.round(0.0), Brush::solid(pal.surface.rgb, pal.surface.a));
        p.line(a.x, a.bottom() - 0.5, a.right(), a.bottom() - 0.5, 1.0, pal.line);
        let i : i32 = Mathx::clampI(self.model.get(), 0, (self.names.length as i32) - 1);
        p.text(FaceKind::Bold, self.names[i as i64], a.x + 24.0, ctx.baselineIn(FaceKind::Bold, 18.0, a.y, a.h), 18.0, pal.text);
        let t : dyn Widget = self.trailing[0];
        t.paint(ctx, p);
    }
}
