// badge — small things that label other things: a badge, an avatar.
//
// A `Badge` is a pill of text in a tone (neutral, accent, ok, warn, danger) — a count, a status, a
// tag. An `Avatar` is a disc with a person's initial on a colour derived from their name, so the
// same person is the same colour everywhere without anyone choosing it.

use crate::gfx::mathx::Mathx;
use crate::gfx::tint::{Tint, Px};
use crate::gfx::shapes::{RRect, Brush};
use crate::style::styles::BadgeStyle;
use crate::style::variants::{Tone, BadgeLook, BadgeSize};
use crate::text::fonts::FaceKind;
use crate::text::typeset::Utf8;
use crate::text::strings::Strings;
use crate::core::geometry::{Size, Bounds, Limits};
use crate::core::context::Context;
use crate::core::widget::{Widget, Base};
use crate::paint::painter::Painter;
use crate::widgets::chips::Dot;

/** How a badge looks. */
pub struct BadgeProps {
    /** What it says. */
    pub text : string = "";

    /** What it is saying: the colour. */
    pub tone : Tone = Tone::Accent;

    /** A soft wash with dark ink, or a solid fill with white ink. */
    pub look : BadgeLook = BadgeLook::Subtle;

    /** How large it is. */
    pub size : BadgeSize = BadgeSize::Md;

    /** Whether a status dot leads the text. */
    pub dot : bool = false;
}

/** A small label: a count, a status, a tag. */
pub class Badge : Base, Widget {
    props : BadgeProps;

    /** A neutral badge saying `text`. */
    constructor(text : string) {
        self.props = BadgeProps { text: text, tone: Tone::Neutral };
    }

    /** A badge saying `text` in `tone`. */
    constructor(text : string, tone : Tone) {
        self.props = BadgeProps { text: text, tone: tone };
    }

    /** A badge set as `props` say. */
    constructor(own props : BadgeProps) {
        self.props = props;
    }

    /** Change what it says. */
    pub fn setText(mut self, text : string) : void {
        self.props = BadgeProps { text: text, ..self.props };
    }

    pub(file) fn style(self, ctx : Context) : BadgeStyle {
        return ctx.theme.badgeOf(self.props.tone, self.props.look, self.props.size);
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let st : BadgeStyle = self.style(ctx);
        let mut w : f64 = ctx.textWidth(FaceKind::Bold, self.props.text, st.px) + 2.0 * st.padX;
        if (self.props.dot) {
            w = w + 6.0 + 6.0;
        }
        return limits.constrain(Size { w: Mathx::fmax(w, st.height), h: st.height });
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let st : BadgeStyle = self.style(ctx);
        let a : Bounds = self.area;
        let rr : RRect = a.round(st.radius);
        p.fillRound(rr, Brush::solid(st.fill.rgb, st.fill.a));
        let w : f64 = ctx.textWidth(FaceKind::Bold, self.props.text, st.px);
        let mut full : f64 = w;
        if (self.props.dot) {
            full = full + 12.0;
        }
        let mut x : f64 = a.x + (a.w - full) * 0.5;
        if (self.props.dot) {
            p.line(x + 3.0, a.midY(), x + 3.0, a.midY(), 6.0, st.dot);
            x = x + 12.0;
        }
        let base : f64 = ctx.baselineIn(FaceKind::Bold, st.px, a.y, a.h);
        p.text(FaceKind::Bold, self.props.text, x, base, st.px, st.text);
    }
}

/** A disc with an initial on a colour that comes from the name. */
pub class Avatar : Base, Widget {
    name : string;
    size : f64;
    presence : bool;
    status : Tone;

    /** An avatar for `name`, `size` pixels across. */
    constructor(name : string, size : f64) {
        self.name = name;
        self.size = size;
        self.presence = false;
        self.status = Tone::Neutral;
    }

    /** An avatar with a presence dot of `status` at its corner: green online, amber away, red busy, grey offline. */
    constructor(name : string, size : f64, status : Tone) {
        self.name = name;
        self.size = size;
        self.presence = true;
        self.status = status;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        return limits.constrain(Size { w: self.size, h: self.size });
    }

    /** The hue (0..360) a name maps to: the same name is always the same colour. */
    pub static fn hueOf(name : string) : f64 {
        let mut h : i64 = 7;
        let n : i64 = name.byteLength;
        for (i of 0..n) {
            h = (h * 31 + (name.byteAt(i) as i64)) % 360;
        }
        return h as f64;
    }

    /** The `0xRRGGBB` colour of hue `h` (0..360) at saturation `s` and value `v` (0..1). */
    pub static fn hsv(h : f64, s : f64, v : f64) : i32 {
        let hh : f64 = h / 60.0;
        let sector : i32 = Mathx::floorI(hh);
        let f : f64 = hh - (sector as f64);
        let pp : f64 = v * (1.0 - s);
        let q : f64 = v * (1.0 - s * f);
        let t : f64 = v * (1.0 - s * (1.0 - f));
        let mut r : f64 = v;
        let mut g : f64 = t;
        let mut b : f64 = pp;
        let k : i32 = sector % 6;
        if (k == 1) {
            r = q;
            g = v;
            b = pp;
        } else if (k == 2) {
            r = pp;
            g = v;
            b = t;
        } else if (k == 3) {
            r = pp;
            g = q;
            b = v;
        } else if (k == 4) {
            r = t;
            g = pp;
            b = v;
        } else if (k == 5) {
            r = v;
            g = pp;
            b = q;
        }
        return Px::pack(Mathx::roundI(r * 255.0), Mathx::roundI(g * 255.0), Mathx::roundI(b * 255.0));
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let a : Bounds = self.area;
        Avatar::draw(ctx, p, self.name, a.x, a.y, a.h);
        if (self.presence) {
            let d : f64 = Mathx::fmax(8.0, self.size * 0.3);
            let cx : f64 = a.right() - d * 0.5;
            let cy : f64 = a.bottom() - d * 0.5;
            let pal = ctx.theme.palette;
            p.line(cx, cy, cx, cy, d + 4.0, pal.surface);
            Dot::draw(ctx, p, self.status, cx, cy, d, 0.0);
        }
    }

    /** Draw the avatar of `name` in the square at (`x`, `y`), `size` wide. */
    pub static fn draw(ctx : Context, p : Painter, name : string, x : f64, y : f64, size : f64) : void {
        let hue : f64 = Avatar::hueOf(name);
        let top : i32 = Avatar::hsv(hue, 0.48, 0.86);
        let bottom : i32 = Avatar::hsv(hue, 0.62, 0.66);
        let rr : RRect = RRect::uniform(x, y, size, size, size * 0.5);
        p.fillRound(rr, Brush::linear(top, 255, bottom, 255, 0.0, y, 0.0, y + size));
        let (cp, n) = Utf8::next(name, 0);
        if (n > 0) {
            let mut c : i32 = cp;
            if (c >= 97 && c <= 122) {
                c = c - 32;
            }
            let initial : string = Strings::ofCp(c);
            let px : f64 = size * 0.42;
            let w : f64 = ctx.textWidth(FaceKind::Bold, initial, px);
            let base : f64 = ctx.baselineIn(FaceKind::Bold, px, y, size);
            p.text(FaceKind::Bold, initial, x + (size - w) * 0.5, base, px, Tint::hex(0xFFFFFF));
        }
    }
}

/** Avatars side by side, each overlapping the one before and ringed in the surface colour. */
pub class AvatarGroup : Base, Widget {
    names : string[];
    count : i32;
    size : f64;

    /** A group of the avatars of `names`, each `size` pixels across. */
    constructor(names : string[], size : f64) {
        self.names = names;
        self.count = names.length as i32;
        self.size = size;
    }

    pub fn measure(mut self, ctx : Context, limits : Limits) : Size {
        let step : f64 = self.size * 0.72;
        return limits.constrain(Size { w: self.size + step * ((self.count - 1) as f64), h: self.size });
    }

    pub fn paint(mut self, ctx : Context, p : Painter) : void {
        let a : Bounds = self.area;
        let step : f64 = self.size * 0.72;
        let pal = ctx.theme.palette;
        for (i of 0..self.count) {
            let x : f64 = a.x + step * (i as f64);
            let c : f64 = self.size * 0.5;
            p.line(x + c, a.y + c, x + c, a.y + c, self.size + 4.0, pal.surface);
            Avatar::draw(ctx, p, self.names[i as i64], x, a.y, self.size);
        }
    }
}
