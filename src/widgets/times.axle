// times — a time of day as a whole number of minutes, and what a time picker is told.
//
//     let at : Shared<Model<i32>> = new shared Model<i32>(Times::at(14, 30));
//
// A time is the minutes since midnight (0 to 1439), so it compares and adds like any integer.
// `Times::NONE` means "no time chosen". `Times::parse` reads what a person types ("14:30", "1430",
// "2:30 pm", "9") and `Times::text` writes it back in either the 24-hour or the 12-hour form.

use crate::text::strings::Strings;
use crate::core::format::Format;
use crate::core::geometry::Length;
use crate::style::variants::ControlSize;

/** Time-of-day arithmetic on minutes since midnight. */
pub class Times {
    /** No time: what a model holds before one is chosen. */
    pub static NONE : i32 = -1;

    /** The time `h` hours and `m` minutes after midnight. */
    pub static fn at(h : i32, m : i32) : i32 {
        return h * 60 + m;
    }

    /** The hour of `t`, 0 to 23. */
    pub static fn hour(t : i32) : i32 {
        return t / 60;
    }

    /** The minute of `t`, 0 to 59. */
    pub static fn minute(t : i32) : i32 {
        return t % 60;
    }

    /** `n` with a leading zero when it has one digit. */
    pub static fn two(n : i32) : string {
        if (n < 10) {
            return "0" + Format::whole(n as f64);
        }
        return Format::whole(n as f64);
    }

    /** `t` as "14:30", or as "2:30 PM" when `h24` is false; empty for no time. */
    pub static fn text(t : i32, h24 : bool) : string {
        if (t == Times::NONE) {
            return "";
        }
        if (h24) {
            return Times::two(Times::hour(t)) + ":" + Times::two(Times::minute(t));
        }
        let h : i32 = Times::hour(t);
        let shown : i32 = (h + 11) % 12 + 1;
        return Format::whole(shown as f64) + ":" + Times::two(Times::minute(t)) + (h >= 12 ? " PM" : " AM");
    }

    /**
     * The time a person wrote, or NONE when the text is not one. Digits split by anything else give
     * the hour and the minute ("14:30", "9.05"); one run of three or four digits is hour and minute
     * run together ("1430"); one or two digits are an hour ("9"). A trailing "am" or "pm" makes the
     * hour a 12-hour one.
     */
    pub static fn parse(text : string) : i32 {
        let s : string = Strings::lower(text);
        let len : i64 = s.byteLength;
        let mut nums : i32[] = [0, 0];
        let mut digits : i32[] = [0, 0];
        let mut count : i32 = 0;
        let mut period : i32 = 0;
        let mut i : i64 = 0;
        while (i < len) {
            let c : i32 = s.byteAt(i);
            if (c >= 48 && c <= 57) {
                let mut value : i32 = 0;
                let mut n : i32 = 0;
                while (i < len && s.byteAt(i) >= 48 && s.byteAt(i) <= 57) {
                    value = value * 10 + (s.byteAt(i) - 48);
                    n = n + 1;
                    i = i + 1;
                }
                if (count >= 2 || n > 4) {
                    return Times::NONE;
                }
                nums[count as i64] = value;
                digits[count as i64] = n;
                count = count + 1;
            } else if (c == 97 || c == 112) {
                if (period != 0) {
                    return Times::NONE;
                }
                period = c == 97 ? 1 : 2;
                i = i + 1;
            } else {
                i = i + 1;
            }
        }
        if (count == 0) {
            return Times::NONE;
        }
        return Times::assemble(nums[0 as i64], nums[1 as i64], digits[0 as i64], count, period);
    }

    /** Order parsed numbers into a time; `period` is 0 for none, 1 for am, 2 for pm. */
    pub(file) static fn assemble(a : i32, b : i32, digitsA : i32, count : i32, period : i32) : i32 {
        let mut h : i32 = a;
        let mut m : i32 = 0;
        if (count == 2) {
            m = b;
        } else if (digitsA >= 3) {
            h = a / 100;
            m = a % 100;
        }
        if (period != 0) {
            if (h < 1 || h > 12) {
                return Times::NONE;
            }
            h = h % 12 + (period == 2 ? 12 : 0);
        }
        if (h < 0 || h > 23 || m < 0 || m > 59) {
            return Times::NONE;
        }
        return Times::at(h, m);
    }
}

/** What a time picker is told. */
pub struct TimeProps {
    /** What the picker says while no time is chosen. */
    pub placeholder : string = "Pick or type a time";

    /** Whether times are written on a 24-hour clock rather than with AM and PM. */
    pub h24 : bool = true;

    /** The gap between the minutes the panel offers, which should divide 60. */
    pub step : i32 = 5;

    /** How large the picker's field is. */
    pub size : ControlSize = ControlSize::Md;

    /** The picker's width. */
    pub width : Length = Length::Auto;

    /** Whether the picker is switched off. */
    pub disabled : bool = false;
}
